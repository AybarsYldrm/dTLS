{
  "name": "node-dtls",
  "version": "1.0.0",
  "description": "S\u0131f\u0131r ba\u011f\u0131ml\u0131l\u0131kl\u0131, saf Node.js DTLS 1.3 (RFC 9147) ve DTLS 1.2 (RFC 6347) y\u0131\u011f\u0131n\u0131 \u2014 mTLS, sertifika zinciri do\u011frulama, OCSP/CRL iptal denetimi, SNI, DTLS-SRTP (WebRTC) ve QUIC (RFC 9002) kay\u0131p kurtarmal\u0131 veri kanal\u0131 deste\u011fiyle.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./constants": "./src/constants.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run-all.js",
    "test:kat": "node tests/test-kat.js",
    "test:unit": "node tests/test-unit.js",
    "test:e2e": "node tests/test-e2e.js",
    "test:mtls": "node tests/test-mtls.js",
    "test:srtp": "node tests/test-srtp.js",
    "test:reliable": "node tests/test-reliable.js",
    "test:robust": "node tests/test-robustness.js",
    "test:retransmit": "node tests/test-retransmit.js",
    "certs": "bash scripts/gen-certs.sh",
    "example:server": "node examples/echo-server.js",
    "example:client": "node examples/echo-client.js",
    "test:revocation": "node tests/test-revocation.js",
    "certs:force": "bash scripts/gen-certs.sh --force",
    "example:revocation": "node examples/mtls-revocation.js"
  },
  "keywords": [
    "dtls",
    "dtls1.3",
    "dtls1.2",
    "rfc9147",
    "rfc6347",
    "srtp",
    "dtls-srtp",
    "webrtc",
    "mtls",
    "mutual-tls",
    "udp",
    "datagram",
    "tls",
    "sni",
    "zero-dependency",
    "ocsp",
    "crl",
    "revocation",
    "x509",
    "pki",
    "rfc9002",
    "rfc6960",
    "ocsp-stapling"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AybarsYldrm/dtls.git"
  }
}
